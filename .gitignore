# Tujuan: Aturan ignore root agar source AccAPI terpisah dari dependency, secret, runtime data, dan file kerja lokal.
# Caller: Git, Codex deployment workflow, dan developer lokal saat staging commit.
# Dependensi: Struktur repo Next.js/FastAPI, output Python, SQLite lokal, dan artefak dokumen kerja.
# Main Functions: Mengecualikan build output, environment secret, database/cache, logs, scratch, dan workbook/PDF lokal.
# Side Effects: File yang match pola ini tidak otomatis masuk staging Git.

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local databases and runtime state
*.sqlite
*.sqlite3
*.db
sqlite.db
database.sqlite
python_backend/database.sqlite
python_backend/data/*.json
python_backend/data/*.jsonl
python_backend/data/*.bak
!python_backend/data/.gitkeep
!python_backend/data/golden_priskila_expected.json

# generated outputs, uploads, and runtime logs
python_backend/output/
python_backend/output/payments/
python_backend/output/payments/proofs/
runtime_logs/
scratch/
*.log

# local business documents and spreadsheet/PDF work files
*.xlsx
*.xls
*.csv
*.pdf
~$*

# local debug artifacts and editor workspaces
runtime/
.kilo/

# local skill/tooling repos & scratch docs (bukan kode app)
awesome-codex-skills/
docs/superpowers/

# crash dumps / junk
*.stackdump

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arsip, installer, dump DB & sidecar SQLite — hardblock data raksasa (jangan masuk git)
*.rar
*.zip
*.7z
*.exe
*.apl
*.bak
*.bak*
*.gz
*.db-wal
*.db-shm
*.db-journal

# dashboard-generator: dibekukan 2026-08-01 — tidak ada file BARU yang masuk git.
# Blanket ignore aman: 25 file yang sudah dilacak tidak terpengaruh aturan ini
# (gitignore hanya berlaku untuk untracked), jadi riwayatnya utuh dan tetap bisa
# di-commit manual kalau suatu saat dibutuhkan lagi — pakai `git add -f`.
dashboard-generator/

# python_backend runtime debug artifacts
python_backend/data/debug_ai.txt
python_backend/data/e2e_live_output/
python_backend/.pytest_cache/
# Cache OCR: mahal dibuat ulang (~$15/surat) tapi lokal — tetap di disk, jangan masuk git.
python_backend/data/ocr_cache/
python_backend/data/ocr_cache_pilot/
python_backend/data/manual_cache/
python_backend/data/channel_map/
python_backend/data/e2e_batch_output/
python_backend/data/e2e_live_fonterra_natur_output/
python_backend/data/e2e_live_urc_output/
python_backend/data/loop_master_report.txt

# Scratch & hasil eksperimen — 14.600 file, ~77 MB, sebagian besar pdf.js ter-vendor.
# Bukan sumber, tidak bisa dibersihkan dari history kalau sempat masuk.
outputs/
tmp/
dashboard-generator/hasil_dashboard_data_laporan/
dashboard-generator/data_laporan/
master_barang_principle/
summary_manual_creat/
Data_Penjualan/

# materi referensi bisnis (PDF surat program asli) & poster visi — bukan source code
reference_surat_program/
poster/

# plugin lokal Claude (bukan bagian app)
ponytail/

# API key Mistral OCR — RAHASIA, jangan pernah commit
python_backend/api_key_mistral.txt
