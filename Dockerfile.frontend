# Tujuan: Membangun image standalone Next.js dan menolak startup production tanpa PostgreSQL runtime.
# Caller: GitHub Actions deploy.yml dan operator Docker/Coolify.
# Dependensi: Node.js 22, package-lock.json, Next.js standalone output, init-db.mjs, dan migrate-pg.mjs.
# Main Functions: Install dependency, build frontend, copy artifact minimum, validate DATABASE_URL, start migrations/server.
# Side Effects: Build filesystem image; startup dapat menjalankan migrasi PostgreSQL aditif sebelum membuka port 3000.
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_ACCURATE_CLIENT_ID=
ARG NEXT_PUBLIC_ACCURATE_REDIRECT_URI=http://localhost:3000/api/auth/callback
ARG BETTER_AUTH_URL=http://localhost:3000
ARG BETTER_AUTH_SECRET=build-time-placeholder-change-at-runtime
ARG DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build

ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_FASTAPI_BASE_URL=$NEXT_PUBLIC_FASTAPI_BASE_URL \
    NEXT_PUBLIC_ACCURATE_CLIENT_ID=$NEXT_PUBLIC_ACCURATE_CLIENT_ID \
    NEXT_PUBLIC_ACCURATE_REDIRECT_URI=$NEXT_PUBLIC_ACCURATE_REDIRECT_URI \
    BETTER_AUTH_URL=$BETTER_AUTH_URL \
    BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET \
    DATABASE_URL=$DATABASE_URL

RUN mkdir -p /app/data && npm run build

# ponytail: standalone output bundles only server deps — drops image from ~1GB to ~250MB
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# standalone self-contains server.js + node_modules (incl. @libsql/client for init-db)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /app/scripts/init-db.mjs ./scripts/init-db.mjs
COPY --from=builder /app/scripts/migrate-pg.mjs ./scripts/migrate-pg.mjs
COPY --from=builder /app/scripts/seed-insentif-sales.mjs ./scripts/seed-insentif-sales.mjs

RUN mkdir -p /app/data

EXPOSE 3000
CMD ["sh", "-c", "case \"${DATABASE_URL:-}\" in postgres://*|postgresql://*) ;; *) echo 'DATABASE_URL must be an injected PostgreSQL URL' >&2; exit 1;; esac; node scripts/init-db.mjs && node scripts/migrate-pg.mjs && node server.js"]
